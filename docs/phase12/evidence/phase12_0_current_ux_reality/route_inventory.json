{
  "routeCount": 4,
  "routes": [
    {
      "component": "PlannerWorkbench",
      "route": "/",
      "states": [
        "empty",
        "ready",
        "clarification",
        "eligibility",
        "plan",
        "running",
        "partial",
        "error"
      ],
      "surfaceId": "planner"
    },
    {
      "component": "ScientificWorkspaceShell",
      "route": "/workspaces/{workspaceId}",
      "states": [
        "loading",
        "ready",
        "partial",
        "stale",
        "missing",
        "error",
        "recovery"
      ],
      "surfaceId": "workspace"
    },
    {
      "component": "loading.tsx",
      "route": "/workspaces/{workspaceId}",
      "states": [
        "loading"
      ],
      "surfaceId": "workspace-loading"
    },
    {
      "component": "error.tsx",
      "route": "/workspaces/{workspaceId}",
      "states": [
        "error",
        "recovery"
      ],
      "surfaceId": "workspace-error"
    }
  ],
  "source": "Next app router"
}
