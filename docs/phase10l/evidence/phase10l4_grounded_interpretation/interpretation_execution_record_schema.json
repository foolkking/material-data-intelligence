{
  "$defs": {
    "InterpretationMode": {
      "enum": [
        "DETERMINISTIC",
        "STRICT_PROVIDER"
      ],
      "title": "InterpretationMode",
      "type": "string"
    },
    "InterpretationOutcome": {
      "enum": [
        "INTERPRETATION_READY",
        "INTERPRETATION_READY_WITH_LIMITS",
        "NO_SUPPORTED_EVIDENCE",
        "SOURCE_NOT_TERMINAL",
        "SOURCE_INTEGRITY_FAILED",
        "EVIDENCE_CAP_EXCEEDED",
        "PROVIDER_FAILED",
        "VALIDATION_FAILED"
      ],
      "title": "InterpretationOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "caps": {
      "additionalProperties": {
        "type": "integer"
      },
      "maxProperties": 16,
      "title": "Caps",
      "type": "object"
    },
    "claimCount": {
      "maximum": 32,
      "minimum": 0,
      "title": "Claimcount",
      "type": "integer"
    },
    "createdAt": "2026-07-30T00:00:00+00:00",
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Diagnostics",
      "type": "array"
    },
    "elapsedMs": {
      "minimum": 0,
      "title": "Elapsedms",
      "type": "number"
    },
    "evidenceItemCount": {
      "maximum": 256,
      "minimum": 0,
      "title": "Evidenceitemcount",
      "type": "integer"
    },
    "executionRecordHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Executionrecordhash",
      "type": "string"
    },
    "executionRecordId": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Executionrecordid",
      "type": "string"
    },
    "idempotencyKeyHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotencykeyhash"
    },
    "initialResponseHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initialresponsehash"
    },
    "limitationCount": {
      "maximum": 64,
      "minimum": 0,
      "title": "Limitationcount",
      "type": "integer"
    },
    "mode": {
      "$ref": "#/$defs/InterpretationMode"
    },
    "outcome": {
      "$ref": "#/$defs/InterpretationOutcome"
    },
    "promptProjectionHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Promptprojectionhash"
    },
    "provider": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "providerConfigHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Providerconfighash"
    },
    "providerModel": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Providermodel"
    },
    "providerVersion": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Providerversion",
      "type": "string"
    },
    "repairCount": {
      "maximum": 1,
      "minimum": 0,
      "title": "Repaircount",
      "type": "integer"
    },
    "repairedResponseHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repairedresponsehash"
    },
    "responseHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Responsehash"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourceBundleHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sourcebundlehash",
      "type": "string"
    },
    "sourceBundleId": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Sourcebundleid",
      "type": "string"
    },
    "sourceGraphHash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sourcegraphhash"
    },
    "sourceJobId": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Sourcejobid",
      "type": "string"
    },
    "sourcePlanHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sourceplanhash",
      "type": "string"
    },
    "sourcePlanId": {
      "maxLength": 96,
      "minLength": 1,
      "title": "Sourceplanid",
      "type": "string"
    },
    "warningCount": {
      "maximum": 128,
      "minimum": 0,
      "title": "Warningcount",
      "type": "integer"
    }
  },
  "required": [
    "executionRecordId",
    "executionRecordHash",
    "sourceJobId",
    "sourcePlanId",
    "sourcePlanHash",
    "sourceBundleId",
    "sourceBundleHash",
    "mode",
    "provider",
    "providerVersion",
    "repairCount",
    "evidenceItemCount",
    "claimCount",
    "warningCount",
    "limitationCount",
    "outcome",
    "elapsedMs",
    "createdAt"
  ],
  "title": "InterpretationExecutionRecord",
  "type": "object"
}
