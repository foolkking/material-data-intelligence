# Copy this file to the sibling project-owned runtime as local.env.
MDI_LOCAL_ROOT=E:/1project/mdi-b0-5a1.local
MDI_DATA_ROOT=E:/1project/mdi-b0-5a1.local/data
MDI_RUNTIME_ROOT=E:/1project/mdi-b0-5a1.local/run
MDI_LOG_ROOT=E:/1project/mdi-b0-5a1.local/logs

MDI_ENV=development
MDI_RUNTIME_PROFILE=same-stack
MDI_API_PROXY_TARGET=http://127.0.0.1:8005
DATABASE_URL=postgresql+psycopg://mdi:CHANGE_ME@127.0.0.1:55434/mdi
MDI_DATABASE_URL=postgresql+psycopg://mdi:CHANGE_ME@127.0.0.1:55434/mdi
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55434
MDI_POSTGRES_PORT=55434
POSTGRES_DB=mdi
POSTGRES_USER=mdi
POSTGRES_PASSWORD=CHANGE_ME
MDI_RUNTIME_BACKEND=postgresql

REDIS_URL=redis://127.0.0.1:6380/0
MDI_REDIS_URL=redis://127.0.0.1:6380/0
MDI_QUEUE_BACKEND=redis

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=mdi-artifacts
MDI_ARTIFACT_BACKEND=minio

MDI_AGENT2_ORCHESTRATION_ENABLED=true
MDI_AGENT2_INTERPRETATION_ENABLED=true
MDI_AGENT2_REPORT_ENABLED=true
MDI_AUTH_REQUIRED=true
MDI_CORS_ORIGINS=http://127.0.0.1:3023,http://localhost:3023

# Optional binary overrides used by scripts/dev.ps1
MDI_POSTGRES_BIN=E:/PostgreSQL/17/bin
MDI_REDIS_BIN=E:/Redis
MDI_MINIO_BIN=C:/path/to/minio.exe
MDI_PYTHON=E:/1project/mdi-b0-5a1/.venv/Scripts/python.exe
