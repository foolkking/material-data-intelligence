# Reference template. Run scripts/dev.ps1 init to generate an external local.env.
# Plain KEY=value, no quotes, export prefix or variable interpolation.
# init replaces CHANGE_ME values; never use placeholders to start services.
MDI_ENV=development
MDI_RUNTIME_PROFILE=same-stack
MDI_API_PROXY_TARGET=http://127.0.0.1:8005
MDI_WEB_PORT=3023
# DATABASE_URL is derived from POSTGRES_* (including password URL escaping).
# Legacy MDI_DATABASE_URL / MDI_POSTGRES_* aliases must agree if also defined.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55434
POSTGRES_DB=mdi
POSTGRES_USER=mdi
POSTGRES_PASSWORD=CHANGE_ME
MDI_RUNTIME_BACKEND=postgresql

REDIS_URL=redis://127.0.0.1:6380/0
MDI_QUEUE_BACKEND=redis

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=mdi-local
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=mdi-artifacts
MDI_ARTIFACT_BACKEND=minio
MDI_MINIO_CONSOLE_PORT=9001

MDI_AGENT2_ORCHESTRATION_ENABLED=true
MDI_AGENT2_INTERPRETATION_ENABLED=true
MDI_AGENT2_REPORT_ENABLED=true
MDI_AUTH_REQUIRED=true
MDI_AUTH_COOKIE_SECURE=false
MDI_CORS_ORIGINS=http://127.0.0.1:3023,http://localhost:3023
# Preserve this Fernet key with backups; API and Worker must share it.
MDI_PROVIDER_ENCRYPTION_KEY=CHANGE_ME
# First successful login creates this administrator. No public signup.
MDI_LOCAL_USER_EMAIL=admin@example.invalid
MDI_LOCAL_USER_NAME=Local administrator
MDI_LOCAL_USER_PASSWORD=CHANGE_ME
MDI_LOCAL_USER_PLATFORM_ROLE=PLATFORM_ADMIN

# One local Worker: bound BLAS/OpenMP threads on development machines.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# All filesystem paths are outside the repository. `dev.ps1 init` replaces
# these CHANGE_ME values with absolute paths in the generated local.env.
# MDI_LOCAL_ROOT is the external root that contains local.env and all default
# data, runtime, log, cache and temporary directories.
MDI_LOCAL_ROOT=CHANGE_ME
MDI_DATA_ROOT=CHANGE_ME
MDI_RUNTIME_ROOT=CHANGE_ME
MDI_LOG_ROOT=CHANGE_ME
MDI_TEMP_ROOT=CHANGE_ME
MDI_CACHE_ROOT=CHANGE_ME
# Next.js requires a project-relative output path; dev.ps1 maps it to this external directory.
MDI_NEXT_DIST_DIR=CHANGE_ME
MDI_ARTIFACT_ROOT=CHANGE_ME
# Optional executable overrides (absolute paths, no quotes).
# MDI_POSTGRES_BIN=C:/Program Files/PostgreSQL/17/bin
# MDI_REDIS_EXE=C:/Program Files/Memurai/memurai.exe
# MDI_MINIO_BIN=D:/tools/minio.exe
# MDI_PYTHON=D:/code/material-data-intelligence/.venv/Scripts/python.exe
# MDI_NODE_EXE=D:/tools/node/node.exe
# MDI_NPM_EXE=D:/tools/node/npm.cmd
# Binaries otherwise resolve from PATH; Python defaults to the repo's .venv.
