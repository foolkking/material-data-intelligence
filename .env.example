MDI_ENV=local
MDI_API_APP_NAME=Material Data Intelligence API

# Phase 6: Integration test opt-in
# Set to "1" to enable @pytest.mark.integration tests
MDI_RUN_INTEGRATION=0
# Override for integration tests (optional — auto-built from POSTGRES_*)
MDI_TEST_DATABASE_URL=
# MDI_RUNTIME_BACKEND = local | postgresql
# MDI_QUEUE_BACKEND    = local | redis
# MDI_ARTIFACT_BACKEND = local | minio
MDI_RUNTIME_BACKEND=local
MDI_QUEUE_BACKEND=local
MDI_ARTIFACT_BACKEND=local

# -- PostgreSQL (set POSTGRES_HOST to switch from SQLite to PostgreSQL) --
# Without POSTGRES_HOST, the default database is SQLite for local dev/tests.
# POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mdi
POSTGRES_USER=mdi
POSTGRES_PASSWORD=<LOCAL_POSTGRES_PASSWORD>

# Explicit DATABASE_URL overrides auto-built PostgreSQL URL.
# For SQLite:      DATABASE_URL=sqlite:///./mdi_phase5.db
# For PostgreSQL:  DATABASE_URL=postgresql+psycopg://mdi:<password>@localhost:5432/mdi
# DATABASE_URL=postgresql+psycopg://mdi:<LOCAL_POSTGRES_PASSWORD>@localhost:5432/mdi

# Legacy compat aliases
MDI_POSTGRES_HOST=
MDI_POSTGRES_PASSWORD=<LOCAL_POSTGRES_PASSWORD>
MDI_DATABASE_URL=

# -- Redis for queue worker --
REDIS_URL=redis://localhost:6379/0
MDI_REDIS_URL=redis://localhost:6379/0

# -- MinIO / S3-compatible object storage --
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=mdi-local
MINIO_SECRET_KEY=<LOCAL_MINIO_PASSWORD>
MINIO_BUCKET=mdi-artifacts
MINIO_SECURE=false

# AWS-style env var aliases (used by boto3 auto-discovery)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=mdi-artifacts
S3_REGION=us-east-1
MDI_S3_ENDPOINT_URL=http://localhost:9000
MDI_S3_BUCKET=mdi-artifacts
MDI_S3_REGION=us-east-1
