{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".cache/next/types/**/*.ts",
    ".cache\\next/types/**/*.ts",
    ".next-phase14r-0904/types/**/*.ts",
    ".next-phase14r-0904b/types/**/*.ts",
    ".next-phase14r-0904c/types/**/*.ts",
    ".next-phase14r-0904d/types/**/*.ts",
    ".next-phase14r-0904e/types/**/*.ts",
    ".next-phase9-closure/types/**/*.ts",
    ".next-phase9-smoke/types/**/*.ts",
    ".next-prod-maturity-20260901/types/**/*.ts",
    ".next-prod-maturity-20260902/types/**/*.ts",
    ".next-wave2/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
