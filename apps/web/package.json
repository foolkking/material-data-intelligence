{
  "name": "@mdi/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preflight:disk": "python ../../scripts/phase14r_disk_preflight.py --check-path ../..",
    "dev": "node ../../scripts/workspace_cache_runner.mjs next dev",
    "build": "npm run preflight:disk && node ../../scripts/workspace_cache_runner.mjs next build",
    "start": "node ../../scripts/workspace_cache_runner.mjs next start",
    "lint": "node ../../scripts/workspace_cache_runner.mjs next lint",
    "test": "npm run preflight:disk && node ../../scripts/workspace_cache_runner.mjs vitest run",
    "test:phase10-closure": "npm run preflight:disk && node ../../scripts/workspace_cache_runner.mjs vitest run app/components/viewer-scene/phase10ProductClosure.test.ts",
    "test:phase10-browser-evidence": "npm run preflight:disk && node ../../scripts/workspace_cache_runner.mjs node test/phase10-product-closure-browser-evidence.mjs",
    "test:product-navigation-spa": "npm run preflight:disk && node ../../scripts/workspace_cache_runner.mjs node test/product-navigation-spa-acceptance.mjs",
    "test:trajectory-performance-evidence": "node ../../scripts/workspace_cache_runner.mjs node test/trajectory-performance-evidence-check.mjs",
    "typecheck": "npm run preflight:disk && node ../../scripts/workspace_cache_runner.mjs tsc --project tsconfig.typecheck.json --noEmit --incremental false",
    "playwright:install": "node ../../scripts/workspace_cache_runner.mjs playwright install chromium firefox webkit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.0",
    "fflate": "0.8.3",
    "next": "^15.0.0",
    "plotly.js": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.185.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  }
}
