{
  "$defs": {
    "ArtifactType": {
      "enum": [
        "plotly_json",
        "plotly_html",
        "preview_png",
        "figure_svg",
        "figure_pdf",
        "matterviz_html",
        "matterviz_snapshot_png",
        "structure_json",
        "trajectory_json",
        "trajectory_summary_json",
        "trajectory_report_json",
        "trajectory_manifest_json",
        "phonon_band_json",
        "phonon_band_dos_json",
        "phonon_compatibility_json",
        "phonon_dos_json",
        "phonon_summary_json",
        "phonon_report_json",
        "phonon_manifest_json",
        "phonon_animation_json",
        "phonon_animation_summary_json",
        "phonon_animation_manifest_json",
        "reciprocal_lattice_json",
        "brillouin_zone_json",
        "kpath_json",
        "brillouin_zone_manifest_json",
        "volumetric_grid_json",
        "volumetric_payload_json",
        "volumetric_field_json",
        "volumetric_dataset_json",
        "volumetric_manifest_json",
        "volumetric_structure_overlay_json",
        "volumetric_binary",
        "metrics_json",
        "table_json",
        "table_csv",
        "quality_issues_json",
        "summary_md",
        "report_md",
        "report_html",
        "recipe_json",
        "analysis_plan_json"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "DisplayTarget": {
      "enum": [
        "overview",
        "composition",
        "structure",
        "trajectory",
        "volumetric",
        "phonon",
        "electronic",
        "ml",
        "artifacts",
        "report"
      ],
      "title": "DisplayTarget",
      "type": "string"
    },
    "ImplementationSource": {
      "enum": [
        "pymatviz",
        "pymatviz_composed",
        "matterviz",
        "plotly_custom",
        "platform_builtin",
        "plugin"
      ],
      "title": "ImplementationSource",
      "type": "string"
    },
    "MaterialObjectType": {
      "enum": [
        "Composition",
        "Structure",
        "Atoms",
        "Molecule",
        "DataFrame",
        "PhononBand",
        "PhononDos",
        "PhononEigenvector",
        "Trajectory",
        "ElectronicBand",
        "ElectronicDos",
        "VolumetricData",
        "ElementValueMap",
        "RawUnsupported"
      ],
      "title": "MaterialObjectType",
      "type": "string"
    },
    "ToolCategory": {
      "enum": [
        "visualization",
        "analysis",
        "parser",
        "report",
        "utility"
      ],
      "title": "ToolCategory",
      "type": "string"
    },
    "ToolDomain": {
      "enum": [
        "dataset",
        "table",
        "viz",
        "composition",
        "structure",
        "trajectory",
        "phonon",
        "electronic",
        "simulation",
        "ml",
        "generation",
        "external"
      ],
      "title": "ToolDomain",
      "type": "string"
    },
    "ToolInputOption": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "requiredObjectTypes": {
          "items": {
            "$ref": "#/$defs/MaterialObjectType"
          },
          "title": "Requiredobjecttypes",
          "type": "array"
        },
        "requiredFields": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Requiredfields",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "ToolInputOption",
      "type": "object"
    },
    "ToolInputSchema": {
      "properties": {
        "inputOptions": {
          "items": {
            "$ref": "#/$defs/ToolInputOption"
          },
          "title": "Inputoptions",
          "type": "array"
        },
        "periodicity": {
          "anyOf": [
            {
              "enum": [
                "periodic_required",
                "non_periodic_allowed",
                "any"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Periodicity"
        }
      },
      "title": "ToolInputSchema",
      "type": "object"
    },
    "ToolOutputSchema": {
      "properties": {
        "primaryArtifactType": {
          "$ref": "#/$defs/ArtifactType"
        },
        "secondaryArtifactTypes": {
          "items": {
            "$ref": "#/$defs/ArtifactType"
          },
          "title": "Secondaryartifacttypes",
          "type": "array"
        },
        "displayTarget": {
          "$ref": "#/$defs/DisplayTarget"
        }
      },
      "required": [
        "primaryArtifactType",
        "displayTarget"
      ],
      "title": "ToolOutputSchema",
      "type": "object"
    }
  },
  "properties": {
    "toolId": {
      "title": "Toolid",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/ToolCategory"
    },
    "domain": {
      "$ref": "#/$defs/ToolDomain"
    },
    "implementationSource": {
      "$ref": "#/$defs/ImplementationSource"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "adapter": {
      "title": "Adapter",
      "type": "string"
    },
    "inputSchema": {
      "$ref": "#/$defs/ToolInputSchema"
    },
    "paramsSchema": {
      "additionalProperties": true,
      "title": "Paramsschema",
      "type": "object"
    },
    "outputSchema": {
      "$ref": "#/$defs/ToolOutputSchema"
    },
    "artifactTypes": {
      "items": {
        "$ref": "#/$defs/ArtifactType"
      },
      "title": "Artifacttypes",
      "type": "array"
    },
    "costLevel": {
      "default": "low",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Costlevel",
      "type": "string"
    },
    "defaultTimeoutSec": {
      "default": 30,
      "title": "Defaulttimeoutsec",
      "type": "integer"
    },
    "maxTimeoutSec": {
      "default": 120,
      "title": "Maxtimeoutsec",
      "type": "integer"
    },
    "cachePolicy": {
      "default": "reuse",
      "enum": [
        "reuse",
        "refresh",
        "no_cache"
      ],
      "title": "Cachepolicy",
      "type": "string"
    },
    "permissions": {
      "items": {
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "resourceLimits": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Resourcelimits",
      "type": "object"
    },
    "source": {
      "additionalProperties": true,
      "title": "Source",
      "type": "object"
    },
    "stage": {
      "default": "mvp",
      "enum": [
        "mvp",
        "v1",
        "v2"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "required": [
    "toolId",
    "name",
    "category",
    "domain",
    "implementationSource",
    "description",
    "version",
    "adapter",
    "inputSchema",
    "outputSchema",
    "artifactTypes"
  ],
  "title": "RegisteredTool",
  "type": "object"
}
