{
  "analysisPlanV02": {
    "$defs": {
      "AnalysisStep": {
        "properties": {
          "stepId": {
            "title": "Stepid",
            "type": "string"
          },
          "toolId": {
            "title": "Toolid",
            "type": "string"
          },
