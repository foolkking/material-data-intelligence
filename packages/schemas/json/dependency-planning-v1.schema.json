  "dependencyExecutionRecord": {
    "$defs": {
      "BindingExecutionState": {
        "enum": [
          "PENDING",
          "RESOLVED",
          "FAILED_PRODUCER",
          "MISSING_ARTIFACT",
          "CONTRACT_MISMATCH",
          "SCOPE_MISMATCH",
          "CHECKSUM_MISMATCH",
          "SIZE_REJECTED",
          "CONSUMER_NOT_RUN"
        ],
        "title": "BindingExecutionState",
        "type": "string"
      },
      "DependencyBindingExecution": {
        "additionalProperties": false,
        "properties": {
          "bindingId": {
            "title": "Bindingid",
            "type": "string"
          },
          "state": {
            "$ref": "#/$defs/BindingExecutionState"
          },
          "producerToolCallId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Producertoolcallid"
          },
          "artifactId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Artifactid"
          },
          "artifactChecksum": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Artifactchecksum"
          },
          "consumerToolCallId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Consumertoolcallid"
          },
          "errorCode": {
            "anyOf": [
              {
                "maxLength": 96,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errorcode"
          }
        },
        "required": [
          "bindingId",
          "state"
        ],
        "title": "DependencyBindingExecution",
        "type": "object"
      },
      "DependencyExecutionOutcome": {
        "enum": [
          "ALL_SUCCEEDED",
          "PARTIAL_RESULTS",
          "ALL_FAILED",
          "VALIDATION_ABORTED"
        ],
        "title": "DependencyExecutionOutcome",
        "type": "string"
      },
      "DependencyStepExecution": {
        "additionalProperties": false,
        "properties": {
          "stepId": {
            "title": "Stepid",
            "type": "string"
          },
          "toolId": {
            "title": "Toolid",
            "type": "string"
          },
          "state": {
            "$ref": "#/$defs/StepExecutionState"
          },
          "toolCallId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Toolcallid"
          },
          "artifactIds": {
            "items": {
              "type": "string"
            },
            "maxItems": 64,
            "title": "Artifactids",
            "type": "array"
          },
          "blockedByStepIds": {
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "title": "Blockedbystepids",
            "type": "array"
          },
          "errorCode": {
            "anyOf": [
              {
                "maxLength": 96,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errorcode"
          },
          "errorMessage": {
            "anyOf": [
              {
                "maxLength": 1024,
                "type": "string"
