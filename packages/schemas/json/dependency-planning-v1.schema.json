        "title": "InputRef",
        "type": "object"
      },
      "MaterialObjectType": {
        "enum": [
          "Composition",
          "Structure",
          "Atoms",
          "Molecule",
          "DataFrame",
          "PhononBand",
          "PhononDos",
          "PhononEigenvector",
          "Trajectory",
          "VolumetricData",
          "ElementValueMap",
          "RawUnsupported"
        ],
        "title": "MaterialObjectType",
        "type": "string"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schemaVersion": {
        "const": "0.2",
        "default": "0.2",
        "title": "Schemaversion",
        "type": "string"
      },
      "goal": {
        "maxLength": 16384,
        "minLength": 1,
        "title": "Goal",
        "type": "string"
      },
      "datasetId": {
        "maxLength": 160,
        "minLength": 1,
        "title": "Datasetid",
        "type": "string"
      },
      "profileId": {
        "maxLength": 160,
        "minLength": 1,
        "title": "Profileid",
        "type": "string"
      },
      "toolRegistryVersion": {
        "maxLength": 64,
        "minLength": 1,
        "title": "Toolregistryversion",
        "type": "string"
      },
      "graphHash": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Graphhash",
        "type": "string"
      },
      "assumptions": {
        "items": {
          "type": "string"
        },
        "maxItems": 32,
        "title": "Assumptions",
        "type": "array"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "maxItems": 32,
        "title": "Warnings",
        "type": "array"
      },
      "steps": {
        "items": {
          "$ref": "#/$defs/AnalysisStep"
        },
        "maxItems": 4,
        "minItems": 1,
        "title": "Steps",
        "type": "array"
      },
      "dependencyBindings": {
        "items": {
          "$ref": "#/$defs/DependencyBinding"
        },
        "maxItems": 6,
        "title": "Dependencybindings",
        "type": "array"
      },
      "expectedArtifacts": {
        "items": {
          "$ref": "#/$defs/ExpectedArtifact"
        },
        "maxItems": 64,
        "title": "Expectedartifacts",
        "type": "array"
      }
    },
    "required": [
      "goal",
      "datasetId",
      "profileId",
      "toolRegistryVersion",
      "graphHash",
      "steps"
    ],
    "title": "AnalysisPlanV02",
    "type": "object"
  },
