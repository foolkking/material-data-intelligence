        "type": "object"
      },
      "ExpectedArtifact": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "type": {
            "$ref": "#/$defs/ArtifactType"
          },
          "fromStepId": {
            "anyOf": [
