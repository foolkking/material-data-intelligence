            "type": "string"
          },
          "ref": {
            "title": "Ref",
            "type": "string"
          },
          "fieldRole": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fieldrole"
          },
          "columnName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
